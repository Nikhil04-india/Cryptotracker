/* LoginPage.css */
.login-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    background-color: #f0f0f0;
  }
  
  .login-page h2 {
    margin-bottom: 20px;
    font-size: 24px;
    color: #333;
  }
  
  .login-page form {
    display: flex;
    flex-direction: column;
    width: 300px;
    padding: 20px;
    border-radius: 5px;
    background-color: #fff;
    box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
  }
  
  .login-page form input {
    margin-bottom: 10px;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 5px;
  }
  
  .login-page form a {
    align-self: flex-end;
    margin-bottom: 20px;
    color: #007bff;
    text-decoration: none;
  }
  
  .login-page form button {
    padding: 10px;
    border: none;
    border-radius: 5px;
    color: #fff;
    background-color: #007bff;
    cursor: pointer;
  }
  
  .login-page p {
    margin-top: 20px;
    color: #333;
  }
  
  .login-page p a {
    color: #007bff;
    text-decoration: none;
  }
